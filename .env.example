# Copy to .env for local development. On Vercel add the same names under
# Project Settings -> Environment Variables. NEVER commit a real .env file.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: model ids (check Google AI Studio for currently available models)
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Optional: comma-separated allowed browser origins (default: *)
# CORS_ORIGINS=https://your-app.vercel.app
